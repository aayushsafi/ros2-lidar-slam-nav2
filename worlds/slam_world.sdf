<?xml version="1.0"?>
<sdf version="1.9">
  <world name="slam_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></visual>
      </link>
    </model>

    <!-- Room 8 x 6 m with obstacles -->
    <model name="room">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
        <visual name="nv"><pose>0 3 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry></visual>
        <collision name="s"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry></collision>
        <visual name="sv"><pose>0 -3 0.5 0 0 0</pose><geometry><box><size>8.2 0.2 1</size></box></geometry></visual>
        <collision name="e"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="ev"><pose>4 0 0.5 0 0 0</pose><geometry><box><size>0.2 6 1</size></box></geometry></visual>
        <collision name="w"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.2 6 1</size></box></geometry></collision>
        <visual name="wv"><pose>-4 0 0.5 0 0 0</pose><geometry><box><size>0.2 6 1</size></box></geometry></visual>
        <collision name="block"><pose>1.5 1 0.5 0 0 0</pose><geometry><box><size>1 1 1</size></box></geometry></collision>
        <visual name="blockv"><pose>1.5 1 0.5 0 0 0</pose><geometry><box><size>1 1 1</size></box></geometry></visual>
        <collision name="divider"><pose>-1.5 -1.5 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry></collision>
        <visual name="dividerv"><pose>-1.5 -1.5 0.5 0 0 0</pose><geometry><box><size>0.2 3 1</size></box></geometry></visual>
        <collision name="pillar"><pose>2 -1.5 0.5 0 0 0</pose><geometry><box><size>0.4 0.4 1</size></box></geometry></collision>
        <visual name="pillarv"><pose>2 -1.5 0.5 0 0 0</pose><geometry><box><size>0.4 0.4 1</size></box></geometry></visual>
      </link>
    </model>

    <!-- Differential-drive robot with LiDAR -->
    <model name="robot">
      <pose>0 0 0 0 0 0</pose>
      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial><mass>5</mass><inertia><ixx>0.076</ixx><iyy>0.114</iyy><izz>0.171</izz></inertia></inertial>
        <collision name="chassis"><geometry><box><size>0.5 0.4 0.15</size></box></geometry></collision>
        <visual name="chassis_v"><geometry><box><size>0.5 0.4 0.15</size></box></geometry></visual>
        <collision name="caster">
          <pose>-0.2 0 -0.05 0 0 0</pose>
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <collision name="caster_front">
          <pose>0.2 0 -0.05 0 0 0</pose>
          <geometry><sphere><radius>0.05</radius></sphere></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <sensor name="lidar" type="gpu_lidar">
          <pose>0 0 0.12 0 0 0</pose>
          <topic>scan</topic>
          <gz_frame_id>lidar_link</gz_frame_id>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan><horizontal>
              <samples>360</samples><resolution>1</resolution>
              <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
            </horizontal></scan>
            <range><min>0.12</min><max>10.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>

      <link name="left_wheel">
        <pose>0 0.225 0.1 -1.5708 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.0014</ixx><iyy>0.0014</iyy><izz>0.0025</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></visual>
      </link>
      <link name="right_wheel">
        <pose>0 -0.225 0.1 -1.5708 0 0</pose>
        <inertial><mass>0.5</mass><inertia><ixx>0.0014</ixx><iyy>0.0014</iyy><izz>0.0025</izz></inertia></inertial>
        <collision name="c"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.1</radius><length>0.05</length></cylinder></geometry></visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.45</wheel_separation>
        <wheel_radius>0.1</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <odom_publish_frequency>20</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>

